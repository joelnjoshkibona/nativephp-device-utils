{
    "name": "blutrixx/nativephp-device-utils",
    "version": "1.0.0",
    "description": "Native device utilities for NativePHP Mobile — system insets, file picking, and app storage access",
    "type": "nativephp-plugin",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Blutrixx\\DeviceUtils\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Blutrixx\\DeviceUtils\\DeviceUtilsServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.1"
    }
}
